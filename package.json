{
  "name": "tinygpt-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "cargo build --manifest-path crates/tinygpt-wgsl-engine/Cargo.toml --target wasm32-unknown-unknown --release",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:phase0": "node scripts/e2e-bench.mjs --stage phase0",
    "e2e:phase1": "node scripts/e2e-bench.mjs --stage phase1",
    "e2e:phase2": "node scripts/e2e-bench.mjs --stage phase2",
    "e2e:all": "node scripts/e2e-bench.mjs --stage all",
    "e2e:track1": "node scripts/run-track1-matrix.mjs",
    "e2e:track2": "node scripts/run-track2-wgsl.mjs",
    "e2e:track2:real": "node scripts/run-track2-real.mjs",
    "bundle:model": "node scripts/bundle-model.mjs",
    "e2e:track3": "node scripts/run-track3-smoothness.mjs",
    "e2e:track4": "node scripts/run-track4-speed.mjs",
    "e2e:track5": "node scripts/run-track5-speed.mjs",
    "e2e:track6": "node scripts/run-track6-ux-crossgpu.mjs",
    "e2e:track6:matrix": "node scripts/run-track6-4mode-matrix.mjs",
    "eval:firecrawl": "node scripts/eval-search-and-page.mjs",
    "bundle:gemma4": "node scripts/bundle-gemma4.mjs",
    "e2e:gemma4:track1": "node scripts/run-gemma4-track1-ort.mjs",
    "e2e:gemma4:track2": "node scripts/run-gemma4-track2-wgsl.mjs",
    "e2e:gemma4:track5": "node scripts/run-gemma4-track5-worker.mjs",
    "bench:compare:gemma4-qwen35": "node scripts/compare-gemma4-vs-qwen35.mjs",
    "eval:ecosystem": "node scripts/run-ecosystem-evals.mjs",
    "eval:extension:live": "node scripts/eval-extension-live.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@yours/guard": "git+https://github.com/yours-research/yours-guard.git",
    "@yours/harness": "git+https://github.com/yours-research/yours-harness.git",
    "@yours/memory": "git+https://github.com/yours-research/yours-memory.git",
    "@yours/models": "git+https://github.com/yours-research/yours-models.git",
    "@yours/tools": "git+https://github.com/yours-research/yours-tools.git",
    "@yours/ui": "git+https://github.com/yours-research/yours-ui.git",
    "@yours/voice": "git+https://github.com/yours-research/yours-voice.git",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.312",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@yours/evals": "git+https://github.com/yours-research/yours-evals.git",
    "playwright": "^1.65.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
