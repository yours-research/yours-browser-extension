{
  "manifest_version": 3,
  "name": "Yours Browser Extension",
  "version": "0.1.0",
  "description": "Local-first WebGPU AI assistant powered by @yours/* packages and offline Rust/WGSL engines (Qwen3.5-4B & Gemma 4 E4B).",
  "permissions": [
    "sidePanel",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; object-src 'self';"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Yours Side Panel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
